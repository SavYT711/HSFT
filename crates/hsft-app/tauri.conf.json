{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HSFT",
  "mainBinaryName": "HSFT",
  "identifier": "com.savyt711.hsft",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "HSFT",
        "width": 480,
        "height": 680,
        "minWidth": 400,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SavYT711",
    "category": "Utility",
    "shortDescription": "High-speed file transfer between friends",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
